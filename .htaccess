# --------------------------------------------------------------------------
# Disable ModSecurity (WAF). Fixes 64KB-response 403 errors on cPanel hosts.
# --------------------------------------------------------------------------
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>

# --------------------------------------------------------------------------
# DISABLE LITESPEED CACHE FOR THIS APP.
# Hostinger uses LiteSpeed which aggressively caches responses, INCLUDING
# 503 errors during deploys. This caching causes "formatting broken" issues
# because LiteSpeed serves stale 503s for /_next/static/chunks/*.css and *.js
# even after the real files exist on disk.
# --------------------------------------------------------------------------
<IfModule LiteSpeed>
    CacheDisable public /
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Belt-and-suspenders: tell ANY caching layer (Cloudflare, browser, etc.)
# to revalidate static chunks every time. Next.js fingerprints these
# filenames so cache invalidation works automatically.
<IfModule mod_headers.c>
    <FilesMatch "^_next/static/chunks/.+">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Larger request bodies (mortgage application can be >100KB of form data).
# --------------------------------------------------------------------------
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
</IfModule>

# --------------------------------------------------------------------------
# Compression — reduces over-the-wire response size.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# --------------------------------------------------------------------------
# Force HTTPS (uncomment after SSL is installed and verified)
# --------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
