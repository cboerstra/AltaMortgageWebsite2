# Public site URL (used by metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://altamortgagegroup.net

# Google Analytics / Tag Manager (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ---------------------------------------------------------------------------
# SMTP — used by /api/leads and /api/applications to email new leads
# ---------------------------------------------------------------------------
SMTP_HOST=mail.altamortgagegroup.net
SMTP_PORT=587
SMTP_USER=info@altamortgagegroup.net
SMTP_PASS=replace-with-your-mailbox-password
NOTIFICATION_EMAIL=leads@altamortgagegroup.net

# ---------------------------------------------------------------------------
# CRM webhook — forwards leads + applications to altamortgagecrm.net
# Leave CRM_API_URL blank to skip CRM forwarding entirely.
# ---------------------------------------------------------------------------
CRM_API_URL=https://altamortgagecrm.net/api/webhook
CRM_API_KEY=your-crm-api-key
